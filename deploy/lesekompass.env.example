# Einstellungen für den Lesekompass-Container. Kopieren nach  deploy\lesekompass.env  und ausfüllen.
# Keine Leerzeichen um das "=", nichts hinter dem Wert auf derselben Zeile, jeden Namen nur EINMAL.
# Nach Änderungen:  docker compose -f deploy/docker-compose.yml up -d --force-recreate

# Login (empfohlen, sobald andere Geräte im Netzwerk zugreifen). Format  name:passwort
# Mehrere Logins mit ; trennen:  ich:passwort1;partner:passwort2  – jedes Login hat seine eigene Bibliothek.
# Bitte kein Passwort verwenden, das du anderswo nutzt (im Heimnetz wird es unverschlüsselt übertragen).
LESEKOMPASS_AUTH=

# Optional: KI für „KI fragen“ und den KI-Bibliothekar – einer der beiden Schlüssel genügt.
# Beide bleiben auf dem Server und funktionieren nur mit Login (siehe oben).
# Google Gemini, gratis mit Tageslimit – Schlüssel auf https://aistudio.google.com/apikey erstellen:
GEMINI_API_KEY=
# Claude von Anthropic, nach Verbrauch (https://console.anthropic.com):
ANTHROPIC_API_KEY=

# Optional: Gratis-Ausweich-Kanäle, wenn das Gemini-Kontingent aufgebraucht ist (Reihenfolge wie hier).
# Jeder Schlüssel ist gratis zu haben; leer lassen, was du nicht brauchst.
# Mistral (gutes Deutsch, Gratis-Plan „Experiment“): https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# Groq (sehr schnell, Tageslimit je Modell): https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter (Gratis-Modelle, rund 50 Anfragen pro Tag): https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Nachtschicht: Mit GEMINI_API_KEY nutzt der Server ab dem Abend das restliche Gemini-Tageskontingent für
# deine Bibliothek (Kurzbeschreibungen, Schlagwörter, Lese-Analyse, neue Vorschläge) – bis Google um 9 Uhr
# das Kontingent zurücksetzt. Läuft nur, wenn der Computer dann an ist. 0 = aus.
LESEKOMPASS_NACHTSCHICHT=1
# Ab welcher Stunde (Ortszeit) und welche Zeitzone:
LESEKOMPASS_NACHTSCHICHT_AB=22
LESEKOMPASS_TZ=Europe/Zurich

# Alle wie viele Sekunden nach einer neuen Version schauen (0 = automatische Updates aus).
LESEKOMPASS_UPDATE_INTERVAL=60

# Neue Versionen vor dem Umschalten mit den Tests prüfen (1 = ja, empfohlen).
LESEKOMPASS_UPDATE_TESTS=1

# Woher Updates kommen – nur ändern, wenn du einen anderen Zweig verfolgen willst.
# LESEKOMPASS_REPO_URL=https://github.com/silvanalig95-cmd/Bookshelf.git
# LESEKOMPASS_BRANCH=claude/book-search-recommendation-tool-2w5p6a
