# Optional: Schlüssel für die KI-Funktionen (KI-Wunsch & KI-Bibliothekar) – einer genügt.
# Wird nur vom lokalen Server verwendet und nie an den Browser ausgeliefert.
# Gemini (gratis mit Tageslimit): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Claude (nach Verbrauch): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: Gratis-Ausweich-Kanäle, wenn das Gemini-Kontingent aufgebraucht ist (Reihenfolge wie hier).
# Jeder Schlüssel ist gratis zu haben; leer lassen, was du nicht brauchst.
# Mistral (gutes Deutsch, Gratis-Plan „Experiment“): https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# Groq (sehr schnell, Tageslimit je Modell): https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter (Gratis-Modelle, rund 50 Anfragen pro Tag): https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Optional: Ordner für die Geräte-Synchronisation (Bibliothek, Merkliste … auf allen Geräten gleich).
# Im Docker-Container ist das automatisch eingerichtet.
# LESEKOMPASS_DATA=./daten
